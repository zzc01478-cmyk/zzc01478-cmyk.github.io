# This table affects only the dedicated service user; never flush the host ruleset.
# Loading the file is an atomic replacement of this table.
add table inet social_download
delete table inet social_download
table inet social_download {
    chain output {
        type filter hook output priority 10; policy accept;
        meta skuid "social-download" jump service_egress
    }
    chain service_egress {
        # Only the local engine and DNS stub are reachable on loopback.
        ip daddr 127.0.0.1 tcp dport 18081 accept
        ip saddr 127.0.0.1 ip daddr 127.0.0.1 tcp sport { 8766, 18081 } ct state established accept
        ip daddr 127.0.0.53 udp dport 53 accept
        ip daddr 127.0.0.53 tcp dport 53 accept
        fib daddr type local counter reject
        ip daddr {
            0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24,
            192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15,
            198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3
        } counter reject
        meta nfproto ipv6 counter reject
        tcp dport { 80, 443 } accept
        counter reject
    }
}
